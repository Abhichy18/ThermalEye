# ──────────────────────────────────────────────────────────────────────────
# ThermalEye Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git — add keys via GitHub Secrets for CI.
# All keys below are free-tier.
# ──────────────────────────────────────────────────────────────────────────

# ── Region Selection ──
# Override the default region. Options: barmer, punjab, delhi, hazira, jharia
TE_REGION=barmer

# ── NASA FIRMS (Free, required) ──
# Get your key at: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# ── VIIRS Nightfire ──
# Public CSV data from EOG/NOAA. No key required for batch download.
# Set a local cache dir if desired:
VNF_CACHE_DIR=data/raw/vnf

# ── LLM Providers (at least one recommended; system works without any) ──
# NVIDIA NIM (Primary — fastest inference, free trial)
NVIDIA_NIM_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini (Fallback #1)
GEMINI_API_KEY=

# Groq (Fallback #2 — free, very fast)
GROQ_API_KEY=

# ── Google Earth Engine (Sentinel-2 & Sentinel-5P) ──
# Uses Application Default Credentials:
#   gcloud auth application-default login
# No service-account key needed.
GEE_PROJECT=thermaleye-sih2026

# ── Supabase (Optional — for citizen reports & inspector ledger) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mapbox (Frontend 3D Map) ──
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Historical Window (Optional) ──
# Set to run pipeline over a historical episode instead of live.
# Format: YYYY-MM-DD
# TE_WINDOW_END=2025-11-15
